# Copy to .env.local for local development. On Vercel, add these in Project → Settings → Environment Variables.

# Password for /admin
ADMIN_PASSWORD=change-me

# Long random string used to sign the admin login cookie
# (generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ADMIN_SECRET=

# Database
#  Local:  file:data/portfolio.db   (a SQLite file, created automatically)
#  Vercel: your Turso URL, e.g. libsql://portfolio-yourname.turso.io  (+ DATABASE_AUTH_TOKEN)
DATABASE_URL=file:data/portfolio.db
DATABASE_AUTH_TOKEN=

# Uploads on Vercel: create a Blob store (Storage → Blob) and this is added automatically.
# Leave empty locally: uploads are then saved to data/uploads/.
BLOB_READ_WRITE_TOKEN=
